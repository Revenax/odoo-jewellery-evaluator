<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jewellery_weight_inventory_report_search" model="ir.ui.view">
        <field name="name">jewellery.weight.inventory.report.search</field>
        <field name="model">jewellery.weight.inventory.report</field>
        <field name="arch" type="xml">
            <search string="Weight Inventory">
                <field name="product_id"/>
                <field name="sku_prefix"/>
                <field name="default_code" string="Internal Reference"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="categ_id"/>
                <filter name="diamond_jewellery" string="Diamond Jewellery"
                        domain="[('jewellery_type', '=', 'diamond_jewellery')]"/>
                <group string="Group By">
                    <filter name="g_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="g_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="g_category" string="Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="g_prefix" string="SKU Prefix" context="{'group_by': 'sku_prefix'}"/>
                    <filter name="g_type" string="Jewellery Type" context="{'group_by': 'jewellery_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_jewellery_weight_inventory_report_list" model="ir.ui.view">
        <field name="name">jewellery.weight.inventory.report.list</field>
        <field name="model">jewellery.weight.inventory.report</field>
        <field name="arch" type="xml">
            <list string="Weight Inventory" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="default_code" optional="show"/>
                <field name="sku_prefix" optional="show"/>
                <field name="jewellery_type" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="on_hand_qty" sum="Total Qty"/>
                <field name="total_net_gold_weight_g" sum="Total Net Gold (g)"/>
                <field name="total_diamond_weight_g" sum="Total Diamond (g)"/>
                <field name="total_gross_weight_g" string="Jewellery Weight (g)" sum="Total Jewellery (g)"/>
                <field name="total_weight_reading_g" sum="Total Reading (g)"/>
            </list>
        </field>
    </record>

    <record id="view_jewellery_weight_inventory_report_pivot" model="ir.ui.view">
        <field name="name">jewellery.weight.inventory.report.pivot</field>
        <field name="model">jewellery.weight.inventory.report</field>
        <field name="arch" type="xml">
            <pivot string="Weight Inventory">
                <field name="warehouse_id" type="row"/>
                <field name="jewellery_type" type="col"/>
                <field name="total_net_gold_weight_g" type="measure"/>
                <field name="total_diamond_weight_g" type="measure"/>
                <field name="total_gross_weight_g" type="measure"/>
                <field name="total_weight_reading_g" type="measure"/>
                <field name="on_hand_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_jewellery_weight_inventory_report_graph" model="ir.ui.view">
        <field name="name">jewellery.weight.inventory.report.graph</field>
        <field name="model">jewellery.weight.inventory.report</field>
        <field name="arch" type="xml">
            <graph string="Weight Inventory" type="bar">
                <field name="warehouse_id"/>
                <field name="total_gross_weight_g" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_jewellery_weight_inventory_report" model="ir.actions.act_window">
        <field name="name">Weight Inventory</field>
        <field name="res_model">jewellery.weight.inventory.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_jewellery_weight_inventory_report_search"/>
        <field name="context">{'search_default_g_warehouse': 1}</field>
    </record>

    <menuitem id="menu_jewellery_weight_inventory_report"
              name="Weight Inventory"
              parent="menu_jewellery_inventory_root"
              action="action_jewellery_weight_inventory_report"
              sequence="20"/>
</odoo>
