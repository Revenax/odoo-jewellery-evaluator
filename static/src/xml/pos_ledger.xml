    Author: Mohamed A. Abdallah
    Website: https://www.revenax.com

    Daily Ledger in the register, on the shared HelperDialog. English, left to
    right: Description | Source | Karat | Weight | In | Out | Notes.
    Styling: pos_ledger.scss.
-->
<templates xml:space="preserve">

    <t t-name="jewellery_evaluator.LedgerPopup">
        <HelperDialog title.translate="Daily Ledger" icon="'fa-book'" size="'xl'"
                      status="state.status" close="props.close">
            <t t-set-slot="toolbar">
                <button type="button" class="o_mjh_btn o_mjh_btn_icon" title="Previous day"
                        t-on-click="() => this.shiftDay(-1)"><i class="fa fa-chevron-left"/></button>
                <input type="date" class="o_pl_date" t-att-value="state.date"
                       t-on-change="(ev) => this.setDate(ev.target.value)"/>
                <button type="button" class="o_mjh_btn o_mjh_btn_icon" title="Next day"
                        t-on-click="() => this.shiftDay(1)"><i class="fa fa-chevron-right"/></button>
                <button type="button" class="o_mjh_btn" t-att-disabled="isToday"
                        t-on-click="() => this.goToday()">Today</button>
                <span class="o_mjh_spacer"/>
                <div class="o_mjh_segment">
                    <button type="button" t-att-class="{ active: state.thisRegisterOnly }"
                            t-on-click="() => this.setScope(true)">This register</button>
                    <button type="button" t-att-class="{ active: !state.thisRegisterOnly }"
                            t-on-click="() => this.setScope(false)">All registers</button>
                </div>
                <button type="button" class="o_mjh_btn" t-att-disabled="state.status !== 'ready'"
                        t-on-click="() => this.print()"><i class="fa fa-print"/> Print</button>
            </t>

            <div class="o_pos_ledger" t-if="state.data">
                <div class="o_pl_sheet">
                    <div class="o_pl_head">
                        <div class="o_pl_headbox">
                            <span class="o_pl_lbl">Date</span>
                            <span class="o_pl_val"><t t-esc="state.data.day_name_en"/> <t t-esc="state.data.date"/></span>
                        </div>
                        <div class="o_pl_headbox">
                            <span class="o_pl_lbl">Opening cash</span>
                            <span class="o_pl_val" t-esc="fmt(state.data.opening) or '0'"/>
                        </div>
                        <div class="o_pl_headbox">
                            <span class="o_pl_lbl">Closing cash</span>
                            <span class="o_pl_val">
                                <t t-if="state.data.counted_close === false">
                                    <t t-esc="fmt(state.data.expected_close) or '0'"/>
                                    <small class="o_pl_hint">expected</small>
                                </t>
                                <t t-else="" t-esc="fmt(state.data.counted_close) or '0'"/>
                            </span>
                        </div>
                        <div class="o_pl_headbox">
                            <span class="o_pl_lbl">Register</span>
                            <span class="o_pl_val o_pl_register" t-esc="state.data.serial"/>
                        </div>
                    </div>

                    <div t-if="state.data.difference" class="o_pl_diff">
                        Closing difference: <t t-esc="fmt(state.data.difference)"/>
                    </div>

                    <table class="o_pl_table">
                        <colgroup>
                            <col class="o_pl_c_desc"/><col class="o_pl_c_src"/><col class="o_pl_c_narrow"/>
                            <col class="o_pl_c_weight"/><col class="o_pl_c_money"/><col class="o_pl_c_money"/>
                            <col class="o_pl_c_notes"/>
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Source</th>
                                <th>Karat</th>
                                <th>Weight (g)</th>
                                <th>In</th>
                                <th>Out</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.data.rows" t-as="r" t-key="r_index" t-attf-class="o_pl_row_{{ r.kind }}">
                                <td class="o_pl_desc">
                                    <span t-esc="r.desc"/>
                                    <span t-if="r.qty and r.qty != 1" class="o_pl_qty">×<t t-esc="r.qty"/></span>
                                    <span t-if="r.time" class="o_pl_time" t-esc="r.time"/>
                                </td>
                                <td t-esc="sourceLabel(r)"/>
                                <td class="o_pl_num" t-esc="r.karat"/>
                                <td class="o_pl_num" t-esc="weight(r.grams, r.milli)"/>
                                <td class="o_pl_num o_pl_in" t-esc="fmt(r.in)"/>
                                <td class="o_pl_num o_pl_out" t-esc="fmt(r.out)"/>
                                <td class="o_pl_notes" t-esc="r.notes"/>
                            </tr>
                            <tr t-if="!state.data.rows.length">
                                <td colspan="7" class="o_pl_empty">No movements on this day</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="o_pl_totals">
                                <td colspan="3">Total · net <t t-esc="fmt(state.data.totals.net) or '0'"/> <t t-esc="state.data.currency"/></td>
                                <td class="o_pl_num" t-esc="weight(state.data.totals.grams_in, state.data.totals.milli_in)"/>
                                <td class="o_pl_num" t-esc="fmt(state.data.totals.in)"/>
                                <td class="o_pl_num o_pl_out" t-esc="fmt(state.data.totals.out)"/>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="o_pl_foot">
                        <span t-if="state.data.open_session" class="o_pl_open">Register still open · closing is expected, not counted</span>
                        <span><t t-esc="state.data.registers"/></span>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <span class="o_mjh_foot_note">Read-only</span>
                <button class="o_mjh_btn o_mjh_btn_primary" t-on-click="() => this.props.close()">Close</button>
            </t>
        </HelperDialog>
    </t>

</templates>
