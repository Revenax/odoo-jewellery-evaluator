<templates xml:space="preserve">
    <t t-name="jewellery_evaluator.OrderlineWeight" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <li t-if="jewelleryWeightText" class="o_mj_line_weight text-muted">
                <i class="fa fa-balance-scale me-1"/><t t-esc="jewelleryWeightText"/>
            </li>
        </xpath>
    </t>
</templates>
