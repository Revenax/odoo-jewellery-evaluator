<templates id="template" xml:space="preserve">

    <t t-name="jewellery_evaluator.CurrencyConvertPopup">
        <HelperDialog title.translate="Currency" icon="'fa-exchange'" close="props.close">
            <div class="o_mjh_segment o_mjh_segment_block mb-3">
                <button type="button" t-att-class="{ active: state.direction === 'buy' }"
                        t-on-click="() => this.state.direction = 'buy'">Buy foreign</button>
                <button type="button" t-att-class="{ active: state.direction === 'sell' }"
                        t-on-click="() => this.state.direction = 'sell'">Sell foreign</button>
            </div>
            <div t-on-input="() => this.state.error = ''" t-on-change="() => this.state.error = ''">
                <div class="o_mjh_field">
                    <label>Currency box</label>
                    <select t-model="state.journalId">
                        <t t-foreach="props.journals" t-as="j" t-key="j.id">
                            <option t-att-value="j.id" t-esc="j.name"/>
                        </t>
                    </select>
                </div>
                <div class="o_mjh_row">
                    <div class="o_mjh_field">
                        <label>EGP <span class="o_mjh_hint" t-if="state.direction === 'buy'">out of drawer</span><span class="o_mjh_hint" t-else="">into drawer</span></label>
                        <input type="number" inputmode="decimal" step="0.01" min="0" t-model="state.amountEgp"/>
                    </div>
                    <div class="o_mjh_field">
                        <label><t t-esc="selectedCcy"/> <span class="o_mjh_hint" t-if="state.direction === 'buy'">into box</span><span class="o_mjh_hint" t-else="">out of box</span></label>
                        <input type="number" inputmode="decimal" step="0.01" min="0" t-model="state.toAmount"/>
                    </div>
                </div>
                <div class="o_mjh_field">
                    <label>Rate</label>
                    <input type="text" readonly="readonly" t-att-value="rateText" placeholder="—"/>
                </div>
            </div>
            <div t-if="summary" class="o_mjh_note" t-esc="summary"/>
            <div t-if="state.error" class="o_mjh_error" t-esc="state.error"/>
            <t t-set-slot="footer">
                <button class="o_mjh_btn" t-att-disabled="state.busy" t-on-click="() => this.props.close()">Cancel</button>
                <button class="o_mjh_btn o_mjh_btn_primary" t-att-disabled="state.busy" t-on-click="() => this.confirm()">
                    <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin"/>
                    <t t-if="state.busy">Saving…</t>
                    <t t-else="">Confirm</t>
                </button>
            </t>
        </HelperDialog>
    </t>

    <t t-name="jewellery_evaluator.OwnerTransferPopup">
        <HelperDialog title.translate="Transfer to Owner" icon="'fa-user-circle-o'" close="props.close">
            <div class="o_mjh_segment o_mjh_segment_block mb-3">
                <button type="button" t-att-class="{ active: state.direction === 'out' }"
                        t-on-click="() => this.state.direction = 'out'">Owner takes out</button>
                <button type="button" t-att-class="{ active: state.direction === 'in' }"
                        t-on-click="() => this.state.direction = 'in'">Owner puts in</button>
            </div>
            <div t-on-input="() => this.state.error = ''" t-on-change="() => this.state.error = ''">
                <div class="o_mjh_row">
                    <div class="o_mjh_field">
                        <label>Owner</label>
                        <select t-model="state.ownerId">
                            <t t-foreach="props.owners" t-as="o" t-key="o.id">
                                <option t-att-value="o.id" t-esc="o.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="o_mjh_field">
                        <label>Box</label>
                        <select t-model="state.boxId">
                            <t t-foreach="props.boxes" t-as="b" t-key="b.id">
                                <option t-att-value="b.id" t-esc="b.name"/>
                            </t>
                        </select>
                    </div>
                </div>
                <div class="o_mjh_field">
                    <label>Amount <span class="o_mjh_hint" t-esc="ccy"/></label>
                    <input type="number" inputmode="decimal" step="0.01" min="0" t-model="state.amount"/>
                </div>
                <div t-if="isForeign" class="o_mjh_row">
                    <div class="o_mjh_field">
                        <label>EGP value</label>
                        <input type="number" inputmode="decimal" step="0.01" min="0" t-model="state.amountEgp"/>
                    </div>
                    <div class="o_mjh_field">
                        <label>Rate</label>
                        <input type="text" readonly="readonly" t-att-value="rateText" placeholder="—"/>
                    </div>
                </div>
            </div>
            <div t-if="summary" class="o_mjh_note" t-esc="summary"/>
            <div t-if="state.error" class="o_mjh_error" t-esc="state.error"/>
            <t t-set-slot="footer">
                <button class="o_mjh_btn" t-att-disabled="state.busy" t-on-click="() => this.props.close()">Cancel</button>
                <button class="o_mjh_btn o_mjh_btn_primary" t-att-disabled="state.busy" t-on-click="() => this.confirm()">
                    <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin"/>
                    <t t-if="state.busy">Saving…</t>
                    <t t-else="">Confirm</t>
                </button>
            </t>
        </HelperDialog>
    </t>

</templates>
