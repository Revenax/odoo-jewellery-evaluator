<templates xml:space="preserve">

    <t t-name="jewellery_evaluator.OrderlineBelowMin"
       t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-price')]" position="attributes">
            <attribute name="t-attf-class">{{ vals.isReceipt ? 'font-monospace' : 'fw-bolder' }} {{ isBelowMinimum ? 'o_jewellery_below_min' : '' }}</attribute>
        </xpath>
    </t>

</templates>
