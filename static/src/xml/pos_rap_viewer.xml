    Author: Mohamed A. Abdallah
    Website: https://www.revenax.com

    Read-only Diamond Rapaport price viewer for the register (Look-ups section),
    on the shared HelperDialog. Round/Fancy, < 0.25 ct flat tiers as cards,
    >= 0.25 ct grids. Cells show net $/ct; a carat entry flips them to the total
    stone price. Styling: pos_rap_viewer.scss.
-->
<templates xml:space="preserve">

    <t t-name="jewellery_evaluator.RapViewerPopup">
        <HelperDialog title.translate="Diamond Rap Prices" titleAr="'أسعار الألماس'" icon="'fa-diamond'" size="'xl'"
                      status="state.status" close="props.close">
            <t t-set-slot="toolbar">
                <div class="o_mjh_segment">
                    <button type="button" t-att-class="{ active: state.sheet === 'round' }"
                            t-on-click="() => this.setSheet('round')">Round</button>
                    <button type="button" t-att-class="{ active: state.sheet === 'fancy' }"
                            t-on-click="() => this.setSheet('fancy')">Fancy</button>
                </div>
                <span class="o_mjh_spacer"/>
                <div class="o_mjh_field o_mjh_inline o_pos_rap_carat">
                    <label>Carat</label>
                    <input type="number" inputmode="decimal" min="0" step="0.01" placeholder="—"
                           t-model="state.caratInput"/>
                </div>
                <span class="o_pos_rap_unit" t-esc="unitLabel"/>
            </t>

            <div class="o_pos_rap">
                <t t-foreach="structure" t-as="b" t-key="b.bucket">
                    <div class="o_pos_rap_bucket" t-att-class="{ o_pos_rap_bucket_single: b.single }">
                        <div class="o_pos_rap_bucket_title">
                            <t t-esc="b.bucket"/><span class="ct">ct</span>
                        </div>

                        <!-- < 0.25 ct: one flat per-carat price -->
                        <div t-if="b.single" class="o_pos_rap_tier">
                            <span class="val" t-esc="tierText(b.value)"/>
                            <span class="note">any colour / clarity</span>
                        </div>

                        <!-- >= 0.25 ct: colour x clarity grid -->
                        <div t-else="" class="o_pos_rap_table_wrap">
                            <table class="o_pos_rap_table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th t-foreach="b.cols" t-as="c" t-key="c" t-esc="c"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="b.rows" t-as="r" t-key="r">
                                        <th t-esc="r"/>
                                        <td t-foreach="b.cols" t-as="c" t-key="c"
                                            t-att-class="{ disc: hasDiscount(b.bucket, r, c), empty: !cellText(b.bucket, r, c) }">
                                            <t t-esc="cellText(b.bucket, r, c) or '·'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>

            <t t-set-slot="footer">
                <span class="o_mjh_foot_note">Read-only · net = list × (1 − discount) · gold = discounted cell</span>
                <button class="o_mjh_btn o_mjh_btn_primary" t-on-click="() => this.props.close()">Close</button>
            </t>
        </HelperDialog>
    </t>

</templates>
