<?xml version="1.0" encoding="UTF-8"?>
<!--
    Copyright 2026 Revenax Digital Services
    Author: Mohamed A. Abdallah
    Website: https://www.revenax.com

    Receipt screen (after payment): all of Odoo's print buttons are removed and
    replaced by "Print A5" and "Print A5 Gift", which queue the invoice at the
    branch's A5 printer (pos_gift_invoice.js). Anchored on Odoo 19 core
    point_of_sale.ReceiptScreen.
-->
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click=&quot;() =&gt; doFullPrint.call()&quot;]/.." position="replace">
            <div class="d-flex gap-1">
                <button class="button print btn btn-lg btn-secondary w-100 py-3" t-att-disabled="!!a5.busy"
                        t-on-click="() => this.printA5('a5')">
                    <i t-attf-class="fa {{ a5.busy === 'a5' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print' }} me-1"/>Print A5
                </button>
                <button class="button print btn btn-lg btn-secondary w-100 py-3" t-att-disabled="!!a5.busy"
                        t-on-click="() => this.printA5('gift')">
                    <i t-attf-class="fa {{ a5.busy === 'gift' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-gift' }} me-1"/>Print A5 Gift
                </button>
            </div>
            <button class="button btn btn-lg btn-light border w-100 py-2" t-on-click="() => this.downloadInvoice()">
                <i class="fa fa-download me-1"/>Download Invoice
            </button>
        </xpath>
        <!-- Right panel: the A5 invoice instead of the receipt (falls back to the
             receipt while the order has no server id, e.g. offline). -->
        <xpath expr="//OrderReceipt" position="replace">
            <iframe t-if="typeof currentOrder.id === 'number'" class="o_mj_invoice_preview"
                    t-att-src="'/jewellery/invoice/' + currentOrder.id + '/preview'" title="Invoice"/>
            <OrderReceipt t-else="" order="this.currentOrder"/>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-container')]/div" position="attributes">
            <attribute name="t-att-class">{ 'w-50': !ui.isSmall and typeof currentOrder.id !== 'number', 'o_mj_invoice_frame': typeof currentOrder.id === 'number' }</attribute>
        </xpath>
    </t>
    <!-- Orders tab: A5 printing instead of "Print Receipt" + the invoice button. -->
    <t t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//InvoiceButton" position="replace"/>
        <xpath expr="//button[@t-on-click=&quot;() =&gt; doPrint.call(_selectedSyncedOrder)&quot;]" position="replace">
            <button class="control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1" t-att-disabled="!!a5.busy"
                    t-on-click="() => this.printA5(_selectedSyncedOrder, 'a5')">
                <i t-attf-class="fa {{ a5.busy === 'a5' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print' }} me-1"/>Print A5
            </button>
            <button class="control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1" t-att-disabled="!!a5.busy"
                    t-on-click="() => this.printA5(_selectedSyncedOrder, 'gift')">
                <i t-attf-class="fa {{ a5.busy === 'gift' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-gift' }} me-1"/>Print A5 Gift
            </button>
            <button class="control-button btn btn-light border btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-on-click="() => this.downloadInvoice(_selectedSyncedOrder)">
                <i class="fa fa-download me-1"/>Invoice
            </button>
        </xpath>
    </t>
</templates>
