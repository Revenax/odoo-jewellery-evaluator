<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A5 paper format for gold invoices. Assign to invoice report: Settings > Technical > Reports > Invoice > Paper Format = Marjaan A5 -->
    <data noupdate="0">
        <record id="paperformat_gold_a5" model="report.paperformat">
            <field name="name">Marjaan A5</field>
            <field name="format">A5</field>
            <field name="orientation">Portrait</field>
            <!-- THE knob for the blank "forehead" reserved for the pre-printed
                 letterhead logo: this is a hard top page margin in mm, so the
                 invoice body (title downward) starts this far below the top
                 edge. Raise/lower this single number to taste. -->
            <field name="margin_top">55</field>
            <!-- 25mm bottom leaves room for the 3-column custom footer.
                 Anything < ~20mm causes wkhtmltopdf to silently drop the footer. -->
            <field name="margin_bottom">25</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <!-- No rule under the header: the header is intentionally blank
                 (pre-printed letterhead), so a line would just float at the top. -->
            <field name="header_line" eval="False"/>
            <!-- Blank header needs no breathing room below it. -->
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
