<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_gold" inherit_id="account.report_invoice_document">

    <!-- Inject custom styles + hide the qty/price/discount/tax columns.
         Jewellery invoice columns: SKU | Description | Karat | Weight | Value.
         Quantity/Unit Price/Discount/Taxes are removed (every piece is qty 1). -->
    <xpath expr="//div[contains(@class, 'page') and contains(@class, 'mb-4')]" position="before">
        <style><![CDATA[
            th { font-weight: 900; font-size: 14px; }
            td { font-size: 14px; }
            td.o_stone_row { font-size: 12px; }

            /* Vertical rules between the invoice columns (SKU | Description |
               Karat | Weight | Value). Drawn as a left border on every cell
               except the first, so the count follows the columns automatically
               when the Value column is hidden on a gift invoice. Scoped to the
               line table by name so the totals table stays borderless. */
            table[name='invoice_line_table'] th,
            table[name='invoice_line_table'] td {
                border-left: 1px solid #000;
            }
            table[name='invoice_line_table'] th:first-child,
            table[name='invoice_line_table'] td:first-child {
                border-left: 0;
            }
            /* Keep some air either side of a rule so text never touches it. */
            table[name='invoice_line_table'] th,
            table[name='invoice_line_table'] td {
                padding-left: 8px;
                padding-right: 8px;
            }
        ]]></style>
        <t t-set="display_discount" t-value="False"/>
        <!-- Gift invoice: hide every price (Value column + Total). The flag rides
             in on the report `data` set by the report_gift_invoice wrapper
             template; `data` is always defined on the normal render too, so this
             is a safe no-op there. -->
        <t t-set="jew_gift" t-value="bool(data and data.get('gift'))"/>
    </xpath>

    <!-- Remove the partner address row that sits above the invoice body (Odoo 19) -->
        <xpath expr="//div[contains(@class, 'invoice_main')]/preceding-sibling::div[contains(@class, 'row')][1]" position="replace"/>

        <!-- Force the tax-column conditional off so colspans/totals don't reserve space for taxes -->
        <xpath expr="//t[@t-set='display_taxes']" position="replace">
            <t t-set="display_taxes" t-value="False"/>
        </xpath>

        <!-- Our custom doc title -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span style="margin-bottom: 10px;">
                <center>
                    <span style="font-size: 18px; font-weight: 600;">
                        <span t-if="proforma">PROFORMA </span>
                        <span t-elif="o.move_type == 'out_refund'">Credit Note </span>
                        <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note </span>
                        <span t-elif="o.move_type == 'in_invoice'">Vendor Bill </span>
                        <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
                    </span>
                </center>
                </span>
            </t>
        </xpath>

        <!-- Our Custom Info Block -->
        <xpath expr="//div[@id='informations']" position="replace">
            <div class="row mb-4" name="invoice_to_block" style="margin-bottom: 10px;">
                <div class="col-6 o_invoice_to_block">
                    <div class="o_invoice_to_label"><strong>Invoice to:</strong></div>
                    <div class="o_invoice_to_name"><span t-field="o.partner_id.name"/></div>
                    <div class="o_invoice_to_contact">
                        <t t-if="o.partner_id.phone">
                            <span class="o_invoice_to_phone">Tel: <span t-field="o.partner_id.phone"/></span>
                        </t>
                    </div>
                </div>
                <div class="col-6 text-end">
                    <strong>Date:</strong>
                    <span t-field="o.invoice_date" t-options="{'format': 'dd-MMM-yy'}"/>
                </div>
            </div>
        </xpath>

        <!-- ── Header row: SKU | Description | Karat | Weight | Value ── -->
        <!-- SKU column before Description -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sku" class="text-start"><span>SKU</span></th>
        </xpath>
        <!-- Karat + Weight after Description -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_karat" class="text-end"><span>Karat</span></th>
            <th name="th_weight" class="text-end"><span>Weight</span></th>
        </xpath>
        <!-- Amount header -> "Value" (hidden on the gift invoice) -->
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-end" t-if="not jew_gift"><span>Value</span></th>
        </xpath>
        <!-- Remove Quantity + Unit Price header columns -->
        <xpath expr="//th[@name='th_quantity']" position="replace"/>
        <xpath expr="//th[@name='th_priceunit']" position="replace"/>

        <!-- ── Product line cells ── -->
        <!-- SKU cell before the description cell -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_sku" class="text-start">
                <span t-esc="line.product_id.default_code or line.name"/>
            </td>
        </xpath>
        <!-- Description cell -> "Material Shape" (Title Case) from the product category -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name" class="text-start">
                <!-- product.template.jewellery_description turns the category
                     ("Gold / Coin") into "Gold Coin". It reads complete_name,
                     so it works whether the category is a real parent/child
                     tree or - as in prod - one flat record NAMED "Gold / Coin"
                     with no parent. The previous version walked parent_id,
                     which is None on the flat shape, so invoices printed the
                     raw "[SKU] SKU" line name. Covered by
                     tests/test_line_description.py. -->
                <span t-if="line.product_id.jewellery_description"
                      t-esc="line.product_id.jewellery_description"/>
                <span t-else="" t-field="line.name"/>
            </td>
        </xpath>
        <!-- Karat + Weight cells after the description cell -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_karat" class="text-end">
                <span t-if="line.gold_purity" t-field="line.gold_purity"/>
                <span t-elif="line.silver_purity" t-field="line.silver_purity"/>
                <span t-elif="line.product_id.gold_purity" t-field="line.product_id.gold_purity"/>
                <span t-elif="line.product_id.silver_purity" t-field="line.product_id.silver_purity"/>
            </td>
            <td name="td_weight" class="text-end">
                <!-- line.weight_display is the ONE weight rule, shared with the
                     backend views (account_move_line._compute_jewellery_display_fields
                     -> utils.format_invoice_weight), so the printed invoice and
                     the screen can never disagree. It is blank for a Center
                     Stone — a loose diamond with no gold has no weight to quote,
                     and "0.00g" on an invoice reads as a bug. Covered by
                     tests/test_invoice_weight_display.py. -->
                <span t-if="line.weight_display" t-esc="line.weight_display + 'g'"/>
            </td>
        </xpath>
        <!-- Value cell -> "32,000 EGP" (hidden on the gift invoice) -->
        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" class="text-end" t-if="not jew_gift">
                <span t-out="line.price_subtotal" t-options="{'widget': 'float', 'precision': 0}"/> EGP
            </td>
        </xpath>
        <!-- Remove Quantity + Unit Price cells -->
        <xpath expr="//td[@name='td_quantity']" position="replace"/>
        <xpath expr="//td[@name='td_price_unit']" position="replace"/>

        <!-- ── Stone rows: one per stone under a diamond line, detail in the
             Weight column; SKU/Desc/Karat/Value cells blank.
             The line's `td` sits inside a <t t-if="is_product"> within the row,
             so target the row itself via ancestor:: (a bare //tr[td[...]] can't
             see the nested td). position=after keeps the injected rows inside
             the <t t-foreach="lines_to_report" t-as="line"> loop → one block per
             line, with `line` in scope. ── -->
        <xpath expr="//td[@name='account_invoice_line_name']/ancestor::tr[1]" position="after">
            <t t-set="sp" t-value="line.product_id"/>
            <t t-if="sp.jewellery_type in ('diamond_jewellery', 'center_stone') and sp.stone_ids">
                <tr t-foreach="sp.stone_ids" t-as="stone" t-key="stone.id">
                    <td/><td/><td/>
                    <td class="text-end o_stone_row fst-italic" style="color:#555;">
                        <!-- stone.invoice_display is the SAME formatter behind
                             product.invoice_diamond_note, so this row and the
                             summary note cannot drift: '17 DR 0.29CT'. -->
                        <span t-esc="stone.invoice_display"/>
                    </td>
                    <td t-if="not jew_gift"/>
                </tr>
            </t>
        </xpath>

        <!-- Our custom payment block: single Total Amount line (hidden on gift) -->
        <xpath expr="//div[contains(@class, 'ms-auto')]" position="replace">
            <div class="ms-auto" t-if="not jew_gift">
                <table class="table table-sm table-borderless avoid-page-break-inside">
                    <tr class="border-black fw-bold">
                        <td class="text-end">Total Amount</td>
                        <td class="text-end">
                            <span t-out="o.amount_total" t-options="{'widget': 'float', 'precision': 0}"/> EGP
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>

        <!-- Remove the Taxes column (header + cell + its t-set) -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_taxes']" position="replace"/>
        <xpath expr="//t[@t-set='taxes'][@t-value]" position="replace"/>

        <!-- Suppress "Payment Communication: ..." paragraph -->
        <xpath expr="//p[@name='payment_communication']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- Pull the single-line totals block up to close the gap -->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="style">margin-top: -2rem;</attribute>
        </xpath>

    </template>
</odoo>
