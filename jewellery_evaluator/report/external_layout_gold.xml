<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom per-page PDF footer for the Marjaan Jewellery invoice: a 3-column
    strip (Contact | pre-baked QR to marjaanjewellery.com | Terms). The footer
    body is a shared template t-called by every external_layout variant, so
    wkhtmltopdf renders it on every page regardless of the chosen Document
    Layout. The QR is a static base64 PNG (Odoo's live QR renderer needs
    rlPyCairo, which is not installed on the box).
-->
<odoo>
    <template id="marjaan_invoice_footer_body">
        <div class="o_footer_content row align-items-center" style="border-top: 2px solid #000; padding-top: 8px; font-size: 10px; color: #555;">
            <div class="col-5 text-start">
                Tel: (+2)01000 226 992
            </div>
            <div class="col-2 text-center">
                <img alt="marjaanjewellery.com" style="width:52px;height:52px;"
                     t-att-src="'data:image/png;base64,'"/>
            </div>
            <div class="col-5 text-end">
                info@marjaanjewellery.com<br/>
                www.marjaanjewellery.com
            </div>
        </div>
    </template>

    <template id="external_layout_gold_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_striped" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_bold" inherit_id="web.external_layout_bold">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_boxed" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_folder" inherit_id="web.external_layout_folder">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_wave" inherit_id="web.external_layout_wave">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <template id="external_layout_gold_bubble" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[contains(@class, 'o_footer_content') or contains(@t-attf-class, 'o_footer_content')]" position="replace">
            <t t-call="jewellery_evaluator.marjaan_invoice_footer_body"/>
        </xpath>
    </template>

    <!-- Blank the auto-header on the active (standard) layout: Marjaan prints
         on pre-printed letterhead, so the top must stay clear for the physical
         logo. Keep the `header` class so wkhtmltopdf still reserves the top
         margin but renders nothing.
         priority=999 makes this inherit apply LAST — after core/l10n/EDI views
         (account_edi_ubl_cii, l10n_eg...) have hooked the header's inner divs
         (d-flex, company_address). Since nothing runs after us, replacing the
         whole header with an empty div is safe on the 2026-07 core (deleting it
         at the default priority broke those views' xpaths). -->
    <template id="external_layout_gold_standard_blank_header" inherit_id="web.external_layout_standard" priority="999">
        <xpath expr="//div[contains(@t-attf-class, 'header o_company')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout"/>
        </xpath>
    </template>
</odoo>
