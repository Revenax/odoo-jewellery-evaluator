<odoo>
    <record id="seq_jewellery_acquisition_order" model="ir.sequence">
        <field name="name">Acquisition Order</field>
        <field name="code">jewellery.acquisition.order</field>
        <field name="prefix">AO/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_acquisition_order_list" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.list</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <list string="Acquisition Orders" decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="employee_id" optional="show"/>
                <field name="create_uid" string="Created by" optional="hide"/>
                <field name="warehouse_id" optional="show"/>
                <field name="total_pieces" string="Pieces"/>
                <field name="grams_21k_eq" string="21K eq. (g)" sum="Total"/>
                <field name="making_fee_total" sum="Total"/>
                <field name="stone_carats" optional="hide" sum="Total"/>
                <field name="total_egp" sum="Total"/>
                <field name="registered_count" optional="show"/>
                <field name="unregistered_count" optional="show"/>
                <field name="kind" optional="hide"/>
                <field name="grams_left" optional="show" sum="Total"/>
                <field name="money_left" optional="hide" sum="Total"/>
                <field name="payment_state" widget="badge" optional="show" decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'done'" decoration-warning="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_acquisition_order_form" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.form</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <form string="Acquisition Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_payment_wizard" type="object" string="Pay" icon="fa-money"
                            class="btn-secondary" invisible="state not in ('confirmed', 'done') or payment_state == 'paid'"/>
                    <button name="action_done" type="object" string="Mark as Done" invisible="state != 'confirmed'"/>
                    <button name="action_draft" type="object" string="Back to Draft" invisible="state not in ('confirmed', 'cancel')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancel', 'done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <div class="alert alert-warning mb-0 text-center" role="alert" invisible="not duplicate_warning">
                    <i class="fa fa-exclamation-triangle me-1"/><field name="duplicate_warning" readonly="1" class="d-inline"/>
                </div>
                <sheet>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_state != 'paid'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="kind" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state in ('done', 'cancel')"/>
                        </group>
                    </group>
                    <field name="currency_id" invisible="1"/>
                    <field name="usd_currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <notebook>
                        <page string="Jewellery" name="jewellery">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="categ_id" options="{'no_create': True}"/>
                                    <field name="karat"/>
                                    <field name="origin"/>
                                    <field name="qty" sum="Total"/>
                                    <field name="grams" sum="Total"/>
                                    <field name="fee_per_gram"/>
                                    <field name="fee_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="metal_value"/>
                                <field name="making_fee_total"/>
                                <field name="stones_egp" invisible="not stone_ids"/>
                                <field name="total_egp" class="oe_subtotal_footer_separator"/>
                                <field name="amount_paid" invisible="not amount_paid"/>
                            </group>
                        </page>
                        <page string="Stones" name="stones">
                            <field name="stone_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="shape"/>
                                    <field name="color"/>
                                    <field name="clarity"/>
                                    <field name="qty" sum="Total"/>
                                    <field name="carats" sum="Total"/>
                                    <field name="price_per_carat_usd"/>
                                    <field name="total_usd" sum="Total"/>
                                    <field name="note" optional="hide"/>
                                    <field name="usd_currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" invisible="not stone_ids">
                                <field name="stones_usd"/>
                                <field name="stones_egp" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="SKUs" name="skus">
                            <field name="progress_html" nolabel="1" readonly="1"/>
                            <field name="product_ids" readonly="1" class="mt-3">
                                <list default_order="create_date desc">
                                    <field name="image_128" widget="image" options="{'size': [40, 40]}" string=" "/>
                                    <field name="default_code" string="SKU"/>
                                    <field name="categ_id" string="Category"/>
                                    <field name="gold_purity" string="Karat"/>
                                    <field name="jewellery_type" string="Type" optional="show"/>
                                    <field name="gross_jewellery_weight_g" string="Weight (g)" sum="Total"/>
                                    <field name="net_gold_weight_g" string="Net gold (g)" sum="Total" optional="show"/>
                                    <field name="diamond_weight_g" string="Stones (g)" sum="Total" optional="hide"/>
                                    <field name="list_price" string="Price" optional="show"/>
                                    <field name="qty_available" string="On hand" optional="show"/>
                                    <field name="create_uid" string="Registered by" optional="show"/>
                                    <field name="create_date" string="Registered on" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_state" invisible="1"/>
                            <group>
                                <group string="Metal (21K equivalent)">
                                    <field name="grams_21k_eq" string="Bought"/>
                                    <field name="grams_paid" string="Paid"/>
                                    <field name="grams_left" string="Still owed" decoration-danger="grams_left &gt; 0.001"
                                           decoration-success="grams_left &lt;= 0.001"/>
                                </group>
                                <group string="Money (making fee + stones)">
                                    <field name="money_due" string="Due"/>
                                    <field name="money_paid" string="Paid"/>
                                    <field name="money_left" string="Still owed" decoration-danger="money_left &gt; 1"
                                           decoration-success="money_left &lt;= 1"/>
                                </group>
                            </group>
                            <field name="payment_ids" readonly="1">
                                <list decoration-muted="state == 'cancel'" create="false" delete="false">
                                    <field name="date"/>
                                    <field name="grams_21k" sum="Total"/>
                                    <field name="gold_price_21k"/>
                                    <field name="metal_amount" sum="Total"/>
                                    <field name="money" sum="Total"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="journal_id"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="pos_session_id" optional="hide"/>
                                    <field name="move_id" optional="show"/>
                                    <field name="note" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                                    <button name="action_cancel_payment" type="object" string="Cancel" icon="fa-undo"
                                            invisible="state != 'posted'" confirm="Reverse this payment's entry?"/>
                                </list>
                            </field>
                        </page>
                        <page string="Details" name="details">
                            <group>
                                <group string="Prices used">
                                    <field name="gold_price_21k" readonly="state != 'draft'"/>
                                    <field name="usd_rate" readonly="state != 'draft'"/>
                                </group>
                                <group string="Record">
                                    <field name="vendor_ref"/>
                                    <field name="create_uid" string="Created by" readonly="1"/>
                                    <field name="create_date" string="Created on" readonly="1"/>
                                    <field name="confirmed_by_id" invisible="not confirmed_by_id"/>
                                    <field name="confirmed_on" invisible="not confirmed_on"/>
                                    <field name="write_date" string="Last changed" readonly="1"/>
                                </group>
                                <group string="Gold">
                                    <field name="total_pieces" string="Pieces"/>
                                    <field name="grams_18k"/>
                                    <field name="grams_21k"/>
                                    <field name="grams_24k"/>
                                    <field name="grams_21k_eq"/>
                                </group>
                                <group string="Stones">
                                    <field name="stone_count" string="Stones"/>
                                    <field name="stone_carats"/>
                                    <field name="stones_usd"/>
                                </group>
                                <group string="Registration">
                                    <field name="registered_count"/>
                                    <field name="registered_grams"/>
                                    <field name="unregistered_count"/>
                                    <field name="unregistered_grams"/>
                                    <field name="unmatched_count"/>
                                </group>
                            </group>
                            <separator string="Notes"/>
                            <field name="note" placeholder="Anything worth keeping about this purchase"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_acquisition_order_kanban" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.kanban</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" records_draggable="false"
                    sample="1">
                <field name="state"/>
                <field name="currency_id"/>
                <field name="total_pieces"/>
                <field name="registered_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="date_order" widget="date" class="text-muted"/>
                        </div>
                        <field name="partner_id" class="fs-5"/>
                        <div class="text-muted small">
                            <field name="employee_id"/>
                            <t t-if="record.warehouse_id.raw_value"> · <field name="warehouse_id"/></t>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span><field name="grams_21k_eq"/> g 21K eq.</span>
                            <field name="total_egp" widget="monetary" class="fw-bold"/>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Making fee <field name="making_fee_total" widget="monetary"/></span>
                            <span><t t-esc="record.registered_count.raw_value"/> / <t t-esc="record.total_pieces.raw_value"/> registered</span>
                        </div>
                        <div class="small mt-1">
                            <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'"
                                   decoration-warning="payment_state == 'partial'"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_acquisition_order_pivot" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.pivot</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <pivot string="Acquisitions by vendor and month" sample="1">
                <field name="partner_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="grams_21k_eq" type="measure"/>
                <field name="making_fee_total" type="measure"/>
                <field name="total_egp" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_acquisition_order_graph" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.graph</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <graph string="Acquisitions per month" type="bar" stacked="1" sample="1">
                <field name="date_order" interval="month"/>
                <field name="partner_id"/>
                <field name="grams_21k_eq" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_acquisition_order_search" model="ir.ui.view">
        <field name="name">jewellery.acquisition.order.search</field>
        <field name="model">jewellery.acquisition.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="vendor_ref"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="date" string="Date" date="date_order"/>
                <group>
                    <filter name="by_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_month" string="Month" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_acquisition_order" model="ir.actions.act_window">
        <field name="name">Acquisition Orders</field>
        <field name="res_model">jewellery.acquisition.order</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a new acquisition</p>
            <p>An Acquisition Order records jewellery and stones bought from a vendor: weight per karat, making fee and stones. Pieces registered in the operations app are linked to it.</p>
        </field>
    </record>

    <menuitem id="menu_acquisition_root"
              name="Acquisitions"
              web_icon="jewellery_evaluator,static/description/acquisition_icon.png"
              groups="base.group_user"
              sequence="16"/>
    <menuitem id="menu_acquisition_orders"
              name="Acquisition Orders"
              parent="menu_acquisition_root"
              action="action_acquisition_order"
              groups="base.group_user"
              sequence="10"/>

    <record id="action_acquisition_analysis" model="ir.actions.act_window">
        <field name="name">Acquisitions by Vendor and Month</field>
        <field name="res_model">jewellery.acquisition.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>
    <menuitem id="menu_acquisition_analysis"
              name="Analysis"
              parent="menu_acquisition_root"
              action="action_acquisition_analysis"
              groups="base.group_user"
              sequence="20"/>

    <record id="view_partner_form_acquisitions" model="ir.ui.view">
        <field name="name">res.partner.form.acquisitions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_acquisitions" type="object" class="oe_stat_button" icon="fa-download"
                        invisible="not acquisition_count" groups="base.group_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="acquisition_count"/> AO</span>
                        <span class="o_stat_text"><field name="acquisition_grams_21k_eq" widget="float" digits="[12,1]"/> g bought</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Acquisitions" name="acquisitions" invisible="not acquisition_count" groups="base.group_user">
                    <group>
                        <group>
                            <field name="acquisition_count"/>
                            <field name="acquisition_grams_21k_eq"/>
                            <field name="acquisition_making_fee"/>
                            <field name="acquisition_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="acquisition_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="date_order"/>
                            <field name="total_pieces" string="Pieces"/>
                            <field name="grams_21k_eq" sum="Total"/>
                            <field name="making_fee_total" sum="Total"/>
                            <field name="total_egp" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_acquisition_payment_wizard_form" model="ir.ui.view">
        <field name="name">jewellery.acquisition.payment.wizard.form</field>
        <field name="model">jewellery.acquisition.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Acquisition Order">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group string="Still owed">
                        <field name="grams_left" string="Metal (21K eq. g)"/>
                        <field name="money_left" string="Money"/>
                    </group>
                    <group string="Payment">
                        <field name="journal_id"/>
                        <field name="date"/>
                        <field name="grams_21k"/>
                        <field name="gold_price_21k"/>
                        <field name="money"/>
                        <field name="amount" class="fw-bold"/>
                        <field name="note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_pay" type="object" string="Pay" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_acquisition_payment_list" model="ir.ui.view">
        <field name="name">jewellery.acquisition.payment.list</field>
        <field name="model">jewellery.acquisition.payment</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="grams_21k" sum="Total"/>
                <field name="gold_price_21k"/>
                <field name="money" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="journal_id"/>
                <field name="employee_id"/>
                <field name="move_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="action_acquisition_payment" model="ir.actions.act_window">
        <field name="name">AO Payments</field>
        <field name="res_model">jewellery.acquisition.payment</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_acquisition_payments" name="Payments" parent="menu_acquisition_root"
              action="action_acquisition_payment" sequence="15"/>

</odoo>
