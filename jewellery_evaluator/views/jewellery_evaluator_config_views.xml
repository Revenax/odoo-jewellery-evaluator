<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jewellery_evaluator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.jewellery.evaluator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Jewellery Evaluator" string="Jewellery Evaluator" name="jewellery_evaluator">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Jewellery Evaluator</span>
                                <div class="text-muted">
                                    Configure the API source and pricing rules for gold products.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gold_api_endpoint"/>
                                <div class="text-muted">
                                    URL endpoint for fetching gold prices from the API
                                </div>
                                <div class="content-group">
                                    <field name="gold_api_endpoint"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gold_21k_regex_formula"/>
                                <div class="text-muted">
                                    Regex applied to the API HTML to extract 21K price. Use one capturing group for the number.
                                </div>
                                <div class="content-group">
                                    <field name="gold_21k_regex_formula"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="fallback_price"/>
                                <div class="text-muted">
                                    Fallback gold price per gram when API is unavailable
                                </div>
                                <div class="content-group">
                                    <field name="fallback_price"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Silver</span>
                                <div class="text-muted">
                                    Silver 999 price (set by Selenium script). Markup per gram for silver.
                                </div>
                                <div class="content-group">
                                    <field name="silver_fallback_price"/>
                                    <field name="silver_markup_per_gram"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Markup per Gram</span>
                                <div class="text-muted">
                                    Set per-gram markup based on gold type.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_local"/>
                                <div class="text-muted">
                                    Markup per gram for local jewellery
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_local"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_foreign"/>
                                <div class="text-muted">
                                    Markup per gram for foreign jewellery
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_foreign"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_1g"/>
                                <div class="text-muted">Bars: 1g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_1g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_2_5g"/>
                                <div class="text-muted">Bars: 2.5g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_2_5g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_5g"/>
                                <div class="text-muted">Bars: 5g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_5g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_10g"/>
                                <div class="text-muted">Bars: 10g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_10g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_20g"/>
                                <div class="text-muted">Bars: 20g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_20g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_31g"/>
                                <div class="text-muted">Bars: 31g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_31g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_50g"/>
                                <div class="text-muted">Bars: 50g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_50g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_100g"/>
                                <div class="text-muted">Bars: 100g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_100g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_250g"/>
                                <div class="text-muted">Bars: 250g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_250g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_500g"/>
                                <div class="text-muted">Bars: 500g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_500g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_1000g"/>
                                <div class="text-muted">Bars: 1000g+ (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_1000g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="global_diamond_discount"/>
                                <div class="text-muted">
                                    Discount percentage (0-80). E.g. 40 = 40% off. Sale = (USD x USD/EGP rate) x (100 - discount) / 100.
                                </div>
                                <div class="content-group">
                                    <field name="global_diamond_discount"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
                <app data-string="Point of Sale Jewellery Evaluator" string="Point of Sale" name="point_of_sale_jewellery_evaluator">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Point of Sale</span>
                                <div class="text-muted">
                                    Require customer and default invoicing for the selected Point of Sale.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_config_id"/>
                                <div class="text-muted">
                                    Select which Point of Sale to configure
                                </div>
                                <div class="content-group">
                                    <field name="pos_config_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not pos_config_id">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="require_customer"/>
                                <div class="text-muted">
                                    Optional, Required before paying, or Required before starting the order
                                </div>
                                <div class="content-group">
                                    <field name="require_customer" widget="radio"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not pos_config_id">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_to_invoice_by_default"/>
                                <div class="text-muted">
                                    Default behaviour for new orders: to invoice
                                </div>
                                <div class="content-group">
                                    <field name="pos_to_invoice_by_default"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
