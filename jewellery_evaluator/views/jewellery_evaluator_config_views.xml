<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jewellery_evaluator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.jewellery.evaluator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Jewellery Evaluator" string="Jewellery Evaluator" name="jewellery_evaluator">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Jewellery Evaluator</span>
                                <div class="text-muted">
                                    Configure the API source and pricing rules for gold products.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gold_api_endpoint"/>
                                <div class="text-muted">
                                    URL endpoint for fetching gold prices from the API
                                </div>
                                <div class="content-group">
                                    <field name="gold_api_endpoint"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="gold_21k_regex_formula"/>
                                <div class="text-muted">
                                    Regex applied to the API HTML to extract 21K price. Use one capturing group for the number.
                                </div>
                                <div class="content-group">
                                    <field name="gold_21k_regex_formula"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="fallback_price"/>
                                <div class="text-muted">
                                    Fallback gold price per gram when API is unavailable
                                </div>
                                <div class="content-group">
                                    <field name="fallback_price"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Markup per Gram</span>
                                <div class="text-muted">
                                    Set per-gram markup based on gold type.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_local"/>
                                <div class="text-muted">
                                    Markup per gram for local jewellery
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_local"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_local_min"/>
                                <div class="text-muted">
                                    Min making fee/g (local). Floor = cost + fee*weight. 0 = auto (70% of making fee).
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_local_min"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_foreign"/>
                                <div class="text-muted">
                                    Markup per gram for foreign jewellery
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_foreign"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_jewellery_foreign_min"/>
                                <div class="text-muted">
                                    Min making fee/g (foreign). Floor = cost + fee*weight. 0 = auto (70% of making fee).
                                </div>
                                <div class="content-group">
                                    <field name="markup_jewellery_foreign_min"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_1g"/>
                                <div class="text-muted">Bars: 1g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_1g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_2_5g"/>
                                <div class="text-muted">Bars: 2.5g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_2_5g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_5g"/>
                                <div class="text-muted">Bars: 5g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_5g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_10g"/>
                                <div class="text-muted">Bars: 10g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_10g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_20g"/>
                                <div class="text-muted">Bars: 20g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_20g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_31g"/>
                                <div class="text-muted">Bars: 31g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_31g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_50g"/>
                                <div class="text-muted">Bars: 50g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_50g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_100g"/>
                                <div class="text-muted">Bars: 100g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_100g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_250g"/>
                                <div class="text-muted">Bars: 250g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_250g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_500g"/>
                                <div class="text-muted">Bars: 500g (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_500g"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="markup_bars_1000g"/>
                                <div class="text-muted">Bars: 1000g+ (EGP/g)</div>
                                <div class="content-group">
                                    <field name="markup_bars_1000g"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Silver Pricing -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Silver Pricing</span>
                                <div class="text-muted">
                                    Configure the scrape source and pricing rules for silver products.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="silver_page_url"/>
                                <div class="text-muted">
                                    URL of the page containing the silver 999 price (loaded with a headless browser)
                                </div>
                                <div class="content-group">
                                    <field name="silver_page_url"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="silver_xpath_selector"/>
                                <div class="text-muted">
                                    XPath of the cell that holds the silver 999 price. The first numeric value in its text is used.
                                </div>
                                <div class="content-group">
                                    <field name="silver_xpath_selector"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="silver_fallback_price"/>
                                <div class="text-muted">
                                    Last successfully scraped silver 999 price per gram. Used by product computes; the scheduled scrape refreshes this value.
                                </div>
                                <div class="content-group">
                                    <field name="silver_fallback_price"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="silver_markup_per_gram"/>
                                <div class="text-muted">
                                    Markup per gram added on top of cost for silver products
                                </div>
                                <div class="content-group">
                                    <field name="silver_markup_per_gram"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="silver_markup_per_gram_min"/>
                                <div class="text-muted">
                                    Min making fee/g (silver). Floor = cost + fee*weight. 0 = auto (70% of making fee).
                                </div>
                                <div class="content-group">
                                    <field name="silver_markup_per_gram_min"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Diamond Jewellery Pricing -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Diamond Jewellery Pricing</span>
                                <div class="text-muted">
                                    Global parameters used to compute ticket and sale prices for diamond jewellery products.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="diamond_exchange_rate_usd"/>
                                <div class="text-muted">EGP per 1 USD (update manually as rates change)</div>
                                <div class="content-group">
                                    <field name="diamond_exchange_rate_usd"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="diamond_fee_per_gram_usd"/>
                                <div class="text-muted">Fixed USD making fee added per gram of gold</div>
                                <div class="content-group">
                                    <field name="diamond_fee_per_gram_usd"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="diamond_ticket_multiplier"/>
                                <div class="text-muted">Multiply (gold + stones cost) by this to get the ticket price</div>
                                <div class="content-group">
                                    <field name="diamond_ticket_multiplier"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="diamond_ticket_discount"/>
                                <div class="text-muted">Fraction off the ticket price (0–1, e.g. 0.20 = 20% off)</div>
                                <div class="content-group">
                                    <field name="diamond_ticket_discount"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="diamond_min_sale_pct"/>
                                <div class="text-muted">POS floor as a share of sale price (0–1, e.g. 0.90 = max 10% discount; 0 falls back to an 80% floor — use 0.01 for near-unlimited)</div>
                                <div class="content-group">
                                    <field name="diamond_min_sale_pct"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Stone Tier Prices (USD per stone)</span>
                                <div class="text-muted">Price per stone by carat range. Stones &lt; 0.25 ct use these tiers; ≥ 0.25 ct use the Rapaport grid below.</div>
                                <div class="content-group">
                                    <field name="diamond_stone_tier_1_usd" string="Tier 1 — 0.001–0.089 ct"/>
                                    <field name="diamond_stone_tier_2_usd" string="Tier 2 — 0.090–0.109 ct"/>
                                    <field name="diamond_stone_tier_3_usd" string="Tier 3 — 0.110–0.149 ct"/>
                                    <field name="diamond_stone_tier_4_usd" string="Tier 4 — 0.150–0.199 ct"/>
                                    <field name="diamond_stone_tier_5_usd" string="Tier 5 — 0.200–0.249 ct"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Rapaport Grid (stones ≥ 0.25 ct)</span>
                                <div class="text-muted">Stones ≥ 0.25 ct are priced from the editable Rapaport LIST grid (Round / Fancy).</div>
                                <button name="%(jewellery_evaluator.action_diamond_rap_editor)d" type="action"
                                        string="Open Diamond Rap Prices" class="btn-link" icon="fa-arrow-right"/>
                            </div>
                        </div>
                    </div>
                    <h2>Inventory / Weight Reading</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ticket_weight_g"/>
                                <div class="text-muted">
                                    Fixed weight (g) added per piece for the Weight Reading. Saving recomputes Weight Reading on all products.
                                </div>
                                <div class="content-group">
                                    <field name="ticket_weight_g"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
                <app data-string="Point of Sale Jewellery Evaluator" string="Point of Sale" name="point_of_sale_jewellery_evaluator">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Point of Sale</span>
                                <div class="text-muted">
                                    Require customer and default invoicing for the selected Point of Sale.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_config_id"/>
                                <div class="text-muted">
                                    Select which Point of Sale to configure
                                </div>
                                <div class="content-group">
                                    <field name="pos_config_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not pos_config_id">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="require_customer"/>
                                <div class="text-muted">
                                    Optional, Required before paying, or Required before starting the order
                                </div>
                                <div class="content-group">
                                    <field name="require_customer" widget="radio"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" invisible="not pos_config_id">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pos_to_invoice_by_default"/>
                                <div class="text-muted">
                                    Default behaviour for new orders: to invoice
                                </div>
                                <div class="content-group">
                                    <field name="pos_to_invoice_by_default"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="override_master_pin"/>
                                <div class="text-muted">
                                    Fallback PIN to approve below-minimum sales when pos_hr is off.
                                    With pos_hr on, managers approve with their employee PIN or badge.
                                </div>
                                <div class="content-group">
                                    <field name="override_master_pin" password="True"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
