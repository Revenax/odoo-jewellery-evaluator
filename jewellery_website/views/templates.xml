<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Products are named by SKU for the till. Everywhere the shop prints a
         product name, show the customer-facing website_title instead (it falls
         back to the name, so non-jewellery products are unaffected). -->

    <template id="products_item_title" inherit_id="website_sale.products_item">
        <xpath expr="//a[@t-att-title='product.name']" position="attributes">
            <attribute name="t-att-title">product.website_title or product.name</attribute>
        </xpath>
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]//span[@t-field='product.name']" position="replace">
            <span t-out="product.website_title or product.name"/>
        </xpath>
    </template>

    <template id="product_page_title" inherit_id="website_sale.product">
        <xpath expr="//t[@t-set='additional_title']" position="attributes">
            <attribute name="t-value">product.website_title or product.name</attribute>
        </xpath>
        <xpath expr="//li[hasclass('breadcrumb-item')]/span[@t-field='product.name']" position="replace">
            <span t-out="product.website_title or product.name"/>
        </xpath>
    </template>

    <template id="product_title_heading" inherit_id="website_sale.product_title">
        <xpath expr="//h1[@t-field='product.name']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">product.website_title or product.name</attribute>
        </xpath>
        <!-- Jewellery details under the title: what a customer asks before buying. -->
        <xpath expr="//h1[@t-out='product.website_title or product.name']" position="after">
            <ul t-if="product.jewellery_type" class="list-unstyled small mb-3 o_jewellery_specs">
                <li t-if="product.default_code">
                    <span class="text-muted">Reference</span>
                    <span class="ms-1" t-out="product.default_code"/>
                </li>
                <li t-if="product.gold_purity and product.jewellery_type != 'center_stone'">
                    <span class="text-muted">Karat</span>
                    <span class="ms-1" t-out="product.gold_purity"/>
                    <span t-if="product.jewellery_type == 'diamond_jewellery'"> gold</span>
                </li>
                <li t-if="product.jewellery_weight_g and product.jewellery_type != 'center_stone'">
                    <span class="text-muted">Weight</span>
                    <span class="ms-1" t-out="'%.2f g' % product.jewellery_weight_g"/>
                </li>
                <!-- sudo: visitors may not read jewellery.stone (it holds stone COST
                     prices). Read server-side and print only shape, count, carat,
                     colour and clarity; never grant the public an ACL on it. -->
                <t t-foreach="product.sudo().stone_ids" t-as="stone">
                    <li>
                        <span class="text-muted">Stone</span>
                        <span class="ms-1">
                            <t t-out="stone.quantity"/> ×
                            <span t-field="stone.shape"/> diamond,
                            <t t-out="'%.2f ct' % stone.total_carat"/>
                            <t t-if="stone.color or stone.clarity">
                                (<t t-out="' / '.join(x for x in [stone.color or '', stone.clarity or ''] if x)"/>)
                            </t>
                        </span>
                    </li>
                </t>
            </ul>
        </xpath>
    </template>

    <!-- Price-range filter: "3,500 EGP" like the product cards, not "3,500.00 LE".
         The filter has two copies of the input (collapsible or not); the
         second xpath matches whichever still carries the stock attribute. -->
    <template id="filter_products_price_label" inherit_id="website_sale.filter_products_price">
        <xpath expr="//input[@t-att-data-currency='website.currency_id.symbol']" position="attributes">
            <attribute name="t-att-data-currency">website._shop_currency_label()</attribute>
            <attribute name="t-att-step">1</attribute>
            <attribute name="data-whole-prices">1</attribute>
        </xpath>
        <xpath expr="//input[@t-att-data-currency='website.currency_id.symbol']" position="attributes">
            <attribute name="t-att-data-currency">website._shop_currency_label()</attribute>
            <attribute name="t-att-step">1</attribute>
            <attribute name="data-whole-prices">1</attribute>
        </xpath>
    </template>

    <!-- Cart / checkout totals: prices already include tax (0% today), so the
         "Taxes 0 EGP" row only confused customers. One small note instead.
         HIDE the row, never remove it: checkout.js writes the tax amount into
         tr[name=o_order_total_taxes] after a delivery method is picked, and a
         missing row throws, so the Confirm button never enables (checkout was
         broken 2026-10-14..19 by removing it). -->
    <template id="total_tax_inclusive" inherit_id="website_sale.total">
        <xpath expr="//tr[@name='o_order_total_taxes']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
        <xpath expr="//table" position="after">
            <p class="o_jewellery_tax_note small text-muted mb-0 mt-2">All prices are tax inclusive</p>
        </xpath>
    </template>

    <!-- Cart and checkout thumbnails: the studio shop photo, never the ops-app snapshot. -->
    <template id="cart_lines_shop_photo" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@t-field='line.product_id.image_128']" position="attributes">
            <attribute name="t-field">line.product_id.product_tmpl_id._get_image_holder().image_128</attribute>
        </xpath>
    </template>
    <template id="cart_summary_shop_photo" inherit_id="website_sale.cart_summary_content">
        <xpath expr="//span[@t-field='line.product_id.image_128']" position="attributes">
            <attribute name="t-field">line.product_id.product_tmpl_id._get_image_holder().image_128</attribute>
        </xpath>
    </template>

    <!-- One-of-a-kind pieces cannot be re-ordered: no "Quick reorder" in the cart. -->
    <record id="website_sale.quick_reorder_button" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Contact page: Marjaan's real branches and contacts instead of Odoo's demo block. -->
    <template id="contactus_marjaan_info" inherit_id="website.contactus">
        <xpath expr="//h5[text()='My Company']/.." position="replace">
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0 o_jewellery_contact">
                <h5>Marjaan Jewellery</h5>
                <ul class="list-unstyled mb-3 ps-2">
                    <li class="mb-2"><i class="fa fa-map-marker fa-fw me-2"/><b>Sway Mall</b><br/>
                        <span class="ms-4 d-inline-block">Sway Mall, Mohamed Naguib St., New Cairo</span></li>
                    <li class="mb-2"><i class="fa fa-map-marker fa-fw me-2"/><b>Ismail Ramzy</b><br/>
                        <span class="ms-4 d-inline-block">27 Ismail Ramzy St., Heliopolis</span></li>
                    <li class="mb-2"><i class="fa fa-phone fa-fw me-2"/><a href="tel:+201000226992"><span class="o_force_ltr">+20 100 022 6992</span></a></li>
                    <li class="mb-2"><i class="fa fa-comment fa-fw me-2"/><a href="https://wa.me/201011480480" target="_blank" rel="noopener">WhatsApp <span class="o_force_ltr">+20 10 1148 0480</span></a></li>
                    <li><i class="fa fa-envelope fa-fw me-2"/><a href="mailto:info@marjaanjewellery.com">info@marjaanjewellery.com</a></li>
                </ul>
            </div>
        </xpath>
    </template>

    <!-- Product page promises: match the real refund policy and delivery options
         (Odoo's default said "30-day money-back guarantee, Shipping 2-3 days"). -->
    <template id="product_terms_marjaan" inherit_id="website_sale.product_terms_and_conditions">
        <xpath expr="//small" position="replace">
            <small class="text-muted mb-0 o_jewellery_terms">
                <a href="/refund-policy" class="text-muted"><u>Returns and exchanges within 14 days</u></a><br/>
                Free delivery across Egypt, or pick up at Sway Mall or Ismail Ramzy
            </small>
        </xpath>
    </template>

    <!-- Product page: "You may also like", the closest published pieces
         (same categories, same type, nearest price). Same card markup and
         CSS as the homepage featured grid. -->
    <template id="product_similar_pieces" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_full_description']" position="after">
            <t t-set="similar_pieces" t-value="product._jewellery_similar_pieces(8)"/>
            <section t-if="similar_pieces" class="featured-products-section o_jewellery_similar">
                <t t-set="similar_prices" t-value="similar_pieces._get_sales_prices(website)"/>
                <div class="container">
                    <div class="text-center mb-5">
                        <h2 class="featured-title">You may also like</h2>
                        <p class="featured-subtitle">Pieces close to this one</p>
                    </div>
                    <div class="row featured-grid">
                        <div t-foreach="similar_pieces" t-as="piece" class="d-flex flex-column px-0">
                            <t t-set="title" t-value="piece.website_title or piece.display_name"/>
                            <a class="product-item text-decoration-none" t-att-href="piece.website_url" t-att-title="title">
                                <div class="product-img-box">
                                    <img class="product-img" loading="lazy" t-att-alt="title"
                                         t-att-src="website.image_url(piece._get_image_holder(), 'image_512')"/>
                                </div>
                                <h4 class="product-name" t-out="title"/>
                                <div class="product-price">
                                    <span t-out="similar_prices.get(piece.id, {}).get('price_reduce', piece.list_price)"
                                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                </div>
                            </a>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <a href="/shop" class="explore-btn">Explore</a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <!-- Site-wide footer (every page). The designer's footer lived inside the
         homepage only, and the site footer was left empty, so product, shop and
         checkout pages had none. Same look (.custom-minimal-footer, CSS in the
         website head code) plus branches, phone and WhatsApp. The newsletter
         form is gone: it posted to mass_mailing, which is not installed. Social icons show
         only for the profiles set in Website settings. Priority above the
         website-specific copy of website.footer_custom, which empties #footer. -->
    <template id="footer_marjaan" inherit_id="website.layout" priority="99">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" t-if="not no_footer" class="o_jewellery_footer">
                <div class="custom-minimal-footer">
                    <div class="container-fluid px-lg-5">
                        <div class="footer-top-row">
                            <div class="footer-newsletter o_jewellery_footer_cta">
                                <h3 class="footer-heading">Questions about a piece?</h3>
                                <a class="o_jewellery_footer_btn" href="https://wa.me/201011480480" target="_blank" rel="noopener">Chat with us on WhatsApp</a>
                            </div>
                            <div class="footer-socials" t-if="website.social_facebook or website.social_instagram or website.social_tiktok">
                                <a t-if="website.social_facebook" t-att-href="website.social_facebook" target="_blank" rel="noopener" aria-label="Facebook">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                </a>
                                <a t-if="website.social_instagram" t-att-href="website.social_instagram" target="_blank" rel="noopener" aria-label="Instagram">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                                </a>
                                <a t-if="website.social_tiktok" t-att-href="website.social_tiktok" target="_blank" rel="noopener" aria-label="TikTok">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.78.12V9.77a5.7 5.7 0 0 0-.78-.05 5.68 5.68 0 1 0 5.68 5.68V9.1a7.33 7.33 0 0 0 4.28 1.37V7.39a4.28 4.28 0 0 1-3.22-1.57z"/></svg>
                                </a>
                            </div>
                        </div>
                        <div class="o_jewellery_footer_info">
                            <div>
                                <h4>Sway Mall</h4>
                                <p>Mohamed Naguib St., New Cairo</p>
                            </div>
                            <div>
                                <h4>Ismail Ramzy</h4>
                                <p>27 Ismail Ramzy St., Heliopolis</p>
                            </div>
                            <div>
                                <h4>Contact</h4>
                                <p>
                                    <a href="tel:+201000226992"><span class="o_force_ltr">+20 100 022 6992</span></a><br/>
                                    <a href="https://wa.me/201011480480" target="_blank" rel="noopener">WhatsApp <span class="o_force_ltr">+20 10 1148 0480</span></a><br/>
                                    <a href="mailto:info@marjaanjewellery.com">info@marjaanjewellery.com</a>
                                </p>
                            </div>
                            <div>
                                <h4>Shop</h4>
                                <p>
                                    <a href="/shop">All jewellery</a><br/>
                                    <a href="/about-us">About us</a><br/>
                                    <a href="/contactus">Contact us</a>
                                </p>
                            </div>
                        </div>
                        <div class="footer-bottom-row">
                            <p class="footer-legal">
                                <span>© <t t-out="datetime.date.today().year"/>, Marjaan</span>
                                <span class="legal-dot">·</span>
                                <a href="/privacy">Privacy policy</a>
                                <span class="legal-dot">·</span>
                                <a href="/refund-policy">Refund policy</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
