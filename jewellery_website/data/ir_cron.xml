<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keeps the shop in step with the stock: a piece sold in the boutique comes
         off the website within 15 minutes; a newly registered piece with a photo
         goes on. Quiet runs only read. -->
    <record id="ir_cron_sync_website_catalog" model="ir.cron">
        <field name="name">Website: sync jewellery catalogue</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_website_catalog()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
